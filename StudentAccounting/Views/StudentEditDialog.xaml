<Window x:Class="StudentAccounting.Views.StudentEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Студент" Height="450" Width="400" MinHeight="350" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="ФИО:" Grid.Row="0"/>
        <TextBox Text="{Binding Student.FullName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Row="1" Margin="0,0,0,10"/>
        <Label Content="Группа (ББББ-ЧЧ-ЧЧ):" Grid.Row="2"/>
        <TextBox Text="{Binding Student.Group, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Row="3" Margin="0,0,0,10"/>
        <Label Content="Номер зачётной книжки (8 цифр):" Grid.Row="4"/>
        <TextBox Text="{Binding Student.RecordBookNumber, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Row="5" Margin="0,0,0,10"/>
        <Label Content="Средний балл (2.0-5.0):" Grid.Row="6"/>
        <TextBox Text="{Binding AverageScoreText, UpdateSourceTrigger=PropertyChanged}" Grid.Row="7" Margin="0,0,0,10"/>
        <Label Content="Форма обучения:" Grid.Row="8"/>
        <ComboBox SelectedItem="{Binding Student.EducationForm}" Grid.Row="9" Margin="0,0,0,10">
            <ComboBoxItem>Бюджет</ComboBoxItem>
            <ComboBoxItem>Контракт</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Grid.Row="10" Margin="0,5" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="11" Margin="0,10">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="80" Margin="5" IsEnabled="{Binding IsSaveEnabled}"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="80" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
